<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_urbanstyle_products" model="ir.actions.act_window">
        <field name="name">Productos textiles</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('urbanstyle_is_finished_product', '=', True)]</field>
    </record>
    <record id="action_urbanstyle_raw_materials" model="ir.actions.act_window">
        <field name="name">Materias primas</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('urbanstyle_is_raw_material', '=', True)]</field>
    </record>
    <record id="action_urbanstyle_boms" model="ir.actions.act_window">
        <field name="name">Listas de materiales</field>
        <field name="res_model">mrp.bom</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
    </record>
    <record id="action_urbanstyle_workcenters" model="ir.actions.act_window">
        <field name="name">Centros de trabajo</field>
        <field name="res_model">mrp.workcenter</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_urbanstyle_operations" model="ir.actions.act_window">
        <field name="name">Operaciones de fabricación</field>
        <field name="res_model">mrp.routing.workcenter</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_urbanstyle_productions" model="ir.actions.act_window">
        <field name="name">Órdenes de fabricación</field>
        <field name="res_model">mrp.production</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_urbanstyle_quality_checks" model="ir.actions.act_window">
        <field name="name">Comprobaciones de calidad</field>
        <field name="res_model">quality.check</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_urbanstyle_quality_points" model="ir.actions.act_window">
        <field name="name">Puntos de control</field>
        <field name="res_model">quality.point</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_urbanstyle_purchase_orders" model="ir.actions.act_window">
        <field name="name">Compras</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_urbanstyle_suppliers" model="ir.actions.act_window">
        <field name="name">Proveedores</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('supplier_rank', '&gt;', 0)]</field>
    </record>
    <record id="action_urbanstyle_sales" model="ir.actions.act_window">
        <field name="name">Ventas</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
    </record>

