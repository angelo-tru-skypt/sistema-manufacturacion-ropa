        action="action_urbanstyle_boms" groups="urbanstyle_textile_demo.group_urbanstyle_admin,urbanstyle_textile_demo.group_urbanstyle_production_manager" sequence="40"/>
    <menuitem id="menu_urbanstyle_workcenters" name="Centros de trabajo" parent="menu_urbanstyle_root"
        action="action_urbanstyle_workcenters" groups="urbanstyle_textile_demo.group_urbanstyle_admin,urbanstyle_textile_demo.group_urbanstyle_production_manager" sequence="45"/>
