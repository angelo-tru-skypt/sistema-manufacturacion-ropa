<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_urbanstyle_products" model="ir.actions.act_window">
        <field name="name">Productos textiles</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('urbanstyle_is_finished_product', '=', True)]</field>
        <field name="context">{'default_urbanstyle_is_finished_product': True, 'default_urbanstyle_auto_price': True, 'default_is_storable': True, 'default_sale_ok': True, 'default_purchase_ok': False}</field>
    </record>
    <record id="action_urbanstyle_raw_materials" model="ir.actions.act_window">
        <field name="name">Materias primas</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="urbanstyle_raw_material_search"/>
        <field name="domain">[('urbanstyle_is_raw_material', '=', True)]</field>
        <field name="context">{'default_urbanstyle_is_raw_material': True, 'default_is_storable': True, 'default_sale_ok': False, 'default_purchase_ok': True}</field>
    </record>
    <record id="action_urbanstyle_stock_products" model="ir.actions.act_window">
        <field name="name">Productos UrbanStyle en stock</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_storable', '=', True), ('qty_available', '&gt;', 0), '|', ('product_tmpl_id.urbanstyle_is_raw_material', '=', True), ('product_tmpl_id.urbanstyle_is_finished_product', '=', True)]</field>
    </record>
    <record id="action_urbanstyle_textile_calculator" model="ir.actions.act_window">
        <field name="name">Calculadora textil</field>
        <field name="res_model">urbanstyle.textile.calculator</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <record id="action_urbanstyle_print_designs" model="ir.actions.act_window">
        <field name="name">Diseños y estampados</field>
        <field name="res_model">urbanstyle.print.design</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_urbanstyle_customization_specialties" model="ir.actions.act_window">
        <field name="name">Especializaciones de personalización</field>
        <field name="res_model">urbanstyle.customization.specialty</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_urbanstyle_boms" model="ir.actions.act_window">
        <field name="name">Listas de materiales</field>
        <field name="res_model">mrp.bom</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
    </record>
    <record id="action_urbanstyle_workcenters" model="ir.actions.act_window">
        <field name="name">Centros de trabajo</field>
        <field name="res_model">mrp.workcenter</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_urbanstyle_operations" model="ir.actions.act_window">
        <field name="name">Operaciones de fabricación</field>
        <field name="res_model">mrp.routing.workcenter</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_urbanstyle_productions" model="ir.actions.act_window">
        <field name="name">Órdenes de fabricación</field>
        <field name="res_model">mrp.production</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_urbanstyle_quality_checks" model="ir.actions.act_window">
        <field name="name">Comprobaciones de calidad</field>
        <field name="res_model">quality.check</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_urbanstyle_quality_points" model="ir.actions.act_window">
        <field name="name">Puntos de control</field>
        <field name="res_model">quality.point</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_urbanstyle_purchase_orders" model="ir.actions.act_window">
        <field name="name">Compras</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_urbanstyle_suppliers" model="ir.actions.act_window">
        <field name="name">Proveedores</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('supplier_rank', '&gt;', 0)]</field>
    </record>
    <record id="action_urbanstyle_sales" model="ir.actions.act_window">
        <field name="name">Ventas</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_urbanstyle_products_list_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="urbanstyle_finished_product_list"/>
        <field name="act_window_id" ref="action_urbanstyle_products"/>
    </record>
    <record id="action_urbanstyle_products_form_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="product_template_form_urbanstyle"/>
        <field name="act_window_id" ref="action_urbanstyle_products"/>
    </record>
    <record id="action_urbanstyle_raw_materials_list_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="urbanstyle_raw_material_list"/>
        <field name="act_window_id" ref="action_urbanstyle_raw_materials"/>
    </record>
    <record id="action_urbanstyle_raw_materials_form_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="product_template_form_urbanstyle"/>
        <field name="act_window_id" ref="action_urbanstyle_raw_materials"/>
    </record>
    <record id="action_urbanstyle_stock_products_list_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="urbanstyle_stock_product_list"/>
        <field name="act_window_id" ref="action_urbanstyle_stock_products"/>
    </record>

    <menuitem id="menu_urbanstyle_root" name="URBANSTYLE RD" sequence="5"
        groups="urbanstyle_textile_demo.group_urbanstyle_admin,urbanstyle_textile_demo.group_urbanstyle_production_manager,urbanstyle_textile_demo.group_urbanstyle_operator,urbanstyle_textile_demo.group_urbanstyle_quality_manager,urbanstyle_textile_demo.group_urbanstyle_warehouse"/>
