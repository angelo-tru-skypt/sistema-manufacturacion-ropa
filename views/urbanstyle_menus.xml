    <menuitem id="menu_urbanstyle_workorders" name="Órdenes de trabajo" parent="menu_urbanstyle_root"
        action="mrp.mrp_workorder_todo" groups="urbanstyle_textile_demo.group_urbanstyle_admin,urbanstyle_textile_demo.group_urbanstyle_production_manager,urbanstyle_textile_demo.group_urbanstyle_operator" sequence="55"/>

    <menuitem id="menu_urbanstyle_quality" name="Control de calidad" parent="menu_urbanstyle_root"
