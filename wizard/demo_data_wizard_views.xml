<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_demo_data_wizard_form" model="ir.ui.view">
        <field name="name">urbanstyle.demo.data.wizard.form</field>
        <field name="model">urbanstyle.demo.data.wizard</field>
        <field name="arch" type="xml">
            <form string="Cargar datos de demostración">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Crea proveedores, materias primas, variantes, centros de trabajo, operaciones, controles de calidad y una orden de fabricación de ejemplo. Si ya existen, se conservan y no se duplican.
                    </div>
                </sheet>
                <footer>
                    <button name="action_load_demo_data" type="object" string="Cargar datos de demostración" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_demo_data_wizard" model="ir.actions.act_window">
        <field name="name">Cargar datos de demostración</field>
        <field name="res_model">urbanstyle.demo.data.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_demo_data_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>
